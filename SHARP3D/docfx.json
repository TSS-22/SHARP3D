{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
		  "src": "..",
          "files": ["SHARP3D/SHARP3D/*.csproj"],
          "exclude": ["**/bin/**", "**/obj/**"]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**", "**/bin/**", "**/obj/**"]
      }
    ],
    "resource": [
      {
        "files": ["docfx_assets/images/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "SHARP3D Documentation",
      "_appTitle": "SHARP3D Documentation",
      "_enableSearch": true,
      "pdf": false
    },
  }
}
